# --- Python ---
__pycache__/
*.py[codz]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Editors
.idea/
.cursorignore
.cursorindexingignore

# OS
.DS_Store
Thumbs.db

# --- Minicut Shot Detector Specifics ---

# Media. Mini cuts, mezzanines and splits are far past GitHub's file size
# limits, and removing them from history afterwards is painful.
*.mov
*.mp4
*.mxf
*.mkv
*.avi
*.r3d
*.braw
*.prores
*.dnx

# Frame grabs and image exports
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.exr
*.dpx

# UI screenshots and icons are the exception — they belong in the repo
!assets/**

# Job output: mezzanines, splits, sidecars, stills
output/
outputs/
work/
mezzanine/
stills/

# Test media. Golden-set CSV ground truth IS tracked; the videos are not.
tests/media/
!tests/golden/*.csv

# Scratch clips for hand testing the UI. Generated, never committed.
testmedia/

# Logs
logs/
*.log

# Local backend settings. settings.example.json is the tracked template; the
# real one names a machine's own CLI paths and endpoints, so it is per-install.
settings.json

# ===== PRODUCTION IP — NEVER COMMIT =====
#
# A show's own characters, props and environments. This is a client's
# unreleased material and must not reach a public repository under any
# circumstance.
#
# Everything in the folder is excluded and only the README is allowed back in,
# so a new file added here is ignored by default rather than by remembering to
# add a rule. Reference images and any other format a production drops in are
# covered by the same line.
production/*
!production/README.md
